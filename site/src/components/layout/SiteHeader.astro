---
import { findSidebarForPath, headerNavigation } from '../../lib/navigation';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const activeSidebar = findSidebarForPath(currentPath);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/">
      <span class="site-brand__icon" aria-hidden="true">G</span>
      <span class="site-brand__text">
        <strong>Gamification</strong>
        <span>Base de connaissances</span>
      </span>
    </a>

    <div class="site-header__controls">
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Passer au mode sombre"
        aria-pressed="false"
      >
        <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
          </svg>
        </span>
        <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2.2M12 19.8V22M4.22 4.22l1.56 1.56M18.22 18.22l1.56 1.56M2 12h2.2M19.8 12H22M4.22 19.78l1.56-1.56M18.22 5.78l1.56-1.56"></path>
          </svg>
        </span>
        <span class="theme-toggle__label">Theme</span>
      </button>

      <nav class="site-nav" aria-label="Navigation principale">
        {headerNavigation.map((item) => (
          <a
            class:list={['site-nav__link', activeSidebar?.id === item.sidebarId && 'is-active']}
            href={item.href}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <details class="mobile-nav">
        <summary>Menu</summary>
        <div class="mobile-nav__panel">
          {headerNavigation.map((item) => (
            <a
              class:list={['mobile-nav__link', activeSidebar?.id === item.sidebarId && 'is-active']}
              href={item.href}
            >
              {item.label}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const storageKey = 'gamification-theme';
    const root = document.documentElement;
    const buttons = Array.from(document.querySelectorAll('[data-theme-toggle]'));

    if (buttons.length === 0) {
      return;
    }

    const media = window.matchMedia('(prefers-color-scheme: dark)');

    const getStoredTheme = () => {
      try {
        return localStorage.getItem(storageKey);
      } catch {
        return null;
      }
    };

    const setStoredTheme = (theme) => {
      try {
        localStorage.setItem(storageKey, theme);
      } catch {
        return;
      }
    };

    const resolveTheme = () => {
      const storedTheme = getStoredTheme();

      if (storedTheme === 'light' || storedTheme === 'dark') {
        return storedTheme;
      }

      return media.matches ? 'dark' : 'light';
    };

    const applyTheme = (theme, persist = false) => {
      root.dataset.theme = theme;
      root.style.colorScheme = theme;

      if (persist) {
        setStoredTheme(theme);
      }

      buttons.forEach((button) => {
        const nextLabel = theme === 'dark' ? 'Passer au mode clair' : 'Passer au mode sombre';
        button.setAttribute('aria-label', nextLabel);
        button.setAttribute('aria-pressed', String(theme === 'dark'));
      });
    };

    applyTheme(resolveTheme());

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true);
      });
    });

    const syncWithSystemTheme = (event) => {
      if (getStoredTheme()) {
        return;
      }

      applyTheme(event.matches ? 'dark' : 'light');
    };

    media.addEventListener('change', syncWithSystemTheme);
  })();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--site-header-height);
    background: var(--site-bg);
    border-bottom: 1px solid var(--site-border);
    backdrop-filter: blur(8px);
  }

  .site-header__inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--site-text);
    flex-shrink: 0;
  }

  .site-brand:hover {
    color: var(--site-text);
  }

  .site-brand__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--site-accent);
    color: #fff;
    border-radius: var(--site-radius);
    font-weight: 800;
    font-size: 1.1rem;
  }

  .site-brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .site-brand__text strong {
    font-size: 1rem;
    font-weight: 700;
  }

  .site-brand__text span:last-child {
    font-size: 0.72rem;
    color: var(--site-muted);
    font-weight: 400;
  }

  .site-header__controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* ── Theme toggle ── */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: none;
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius-sm);
    cursor: pointer;
    color: var(--site-text-light);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--site-accent);
    border-color: var(--site-accent);
  }

  .theme-toggle__icon {
    width: 18px;
    height: 18px;
  }

  .theme-toggle__icon--sun {
    display: none;
  }

  [data-theme='dark'] .theme-toggle__icon--moon {
    display: none;
  }

  [data-theme='dark'] .theme-toggle__icon--sun {
    display: block;
  }

  .theme-toggle__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  /* ── Desktop nav ── */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .site-nav__link {
    padding: 0.35rem 0.65rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--site-text-light);
    border-radius: var(--site-radius-sm);
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease;
    white-space: nowrap;
  }

  .site-nav__link:hover {
    color: var(--site-accent);
    background: var(--site-accent-subtle);
  }

  .site-nav__link.is-active {
    color: var(--site-accent);
    font-weight: 600;
  }

  /* ── Mobile nav ── */
  .mobile-nav {
    display: none;
  }

  .mobile-nav > summary {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.85rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--site-text);
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius-sm);
    cursor: pointer;
    list-style: none;
  }

  .mobile-nav > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__panel {
    position: absolute;
    top: var(--site-header-height);
    left: 0;
    right: 0;
    background: var(--site-bg);
    border-bottom: 1px solid var(--site-border);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-shadow: var(--site-shadow-md);
  }

  .mobile-nav__link {
    padding: 0.6rem 1rem;
    font-size: 0.95rem;
    color: var(--site-text);
    text-decoration: none;
    border-radius: var(--site-radius-sm);
  }

  .mobile-nav__link:hover,
  .mobile-nav__link.is-active {
    background: var(--site-accent-subtle);
    color: var(--site-accent);
  }

  @media (max-width: 768px) {
    .site-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }
</style>
