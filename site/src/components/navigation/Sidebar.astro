---
interface SidebarLink {
  label: string;
  link: string;
}

interface SidebarGroup {
  label: string;
  collapsed?: boolean;
  items: SidebarEntry[];
}

type SidebarEntry = SidebarLink | SidebarGroup;

interface Props {
  sidebar: SidebarGroup[];
  currentPath: string;
}

const { sidebar, currentPath } = Astro.props;

function isLink(entry: SidebarEntry): entry is SidebarLink {
  return 'link' in entry;
}

function isCurrentPath(link: string, current: string): boolean {
  const a = link.replace(/\/$/, '') || '/';
  const b = current.replace(/\/$/, '') || '/';
  return a === b;
}

function groupContainsCurrent(group: SidebarGroup, current: string): boolean {
  return group.items.some((item) => {
    if (isLink(item)) return isCurrentPath(item.link, current);
    return groupContainsCurrent(item as SidebarGroup, current);
  });
}
---

<aside class="docs-sidebar" aria-label="Navigation du contenu">
  <div class="docs-sidebar__inner">
    {sidebar.map((group) => (
      <div class="sidebar-section">
        <details
          class="sidebar-group"
          open={group.collapsed !== true || groupContainsCurrent(group, currentPath)}
        >
          <summary class="sidebar-group__title">{group.label}</summary>
          <ul class="sidebar-list">
            {group.items.map((item) =>
              isLink(item) ? (
                <li>
                  <a
                    class:list={['sidebar-link', isCurrentPath(item.link, currentPath) && 'is-current']}
                    href={item.link}
                    aria-current={isCurrentPath(item.link, currentPath) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ) : (
                <li>
                  <details
                    class="sidebar-group sidebar-group--nested"
                    open={(item as SidebarGroup).collapsed !== true || groupContainsCurrent(item as SidebarGroup, currentPath)}
                  >
                    <summary class="sidebar-group__subtitle">{item.label}</summary>
                    <ul class="sidebar-list sidebar-list--nested">
                      {(item as SidebarGroup).items.map((subItem) =>
                        isLink(subItem) ? (
                          <li>
                            <a
                              class:list={['sidebar-link', isCurrentPath(subItem.link, currentPath) && 'is-current']}
                              href={subItem.link}
                              aria-current={isCurrentPath(subItem.link, currentPath) ? 'page' : undefined}
                            >
                              {subItem.label}
                            </a>
                          </li>
                        ) : null
                      )}
                    </ul>
                  </details>
                </li>
              )
            )}
          </ul>
        </details>
      </div>
    ))}
  </div>
</aside>

<style>
  .docs-sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
    max-height: calc(100dvh - var(--header-height) - var(--space-12));
    overflow-y: auto;
    padding-right: var(--space-2);
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.08) transparent;
  }

  .docs-sidebar::-webkit-scrollbar {
    width: 4px;
  }

  .docs-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  .docs-sidebar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
  }

  .docs-sidebar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .docs-sidebar__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* ── Group ────────────────────────── */
  .sidebar-group {
    border: none;
  }

  .sidebar-group__title {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color var(--transition-fast);
  }

  .sidebar-group__title:hover {
    color: var(--color-text-soft);
  }

  .sidebar-group__title::-webkit-details-marker {
    display: none;
  }

  .sidebar-group__title::before {
    content: '';
    display: inline-block;
    width: 0;
    height: 0;
    border-left: 4px solid currentColor;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    margin-right: var(--space-2);
    transition: transform var(--transition-fast);
    vertical-align: middle;
  }

  .sidebar-group[open] > .sidebar-group__title::before {
    transform: rotate(90deg);
  }

  .sidebar-group__subtitle {
    display: block;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-soft);
    cursor: pointer;
    list-style: none;
    transition: color var(--transition-fast);
  }

  .sidebar-group__subtitle:hover {
    color: var(--color-text);
  }

  .sidebar-group__subtitle::-webkit-details-marker {
    display: none;
  }

  /* ── List ──────────────────────────── */
  .sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-2);
  }

  .sidebar-list--nested {
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-border);
    margin-left: var(--space-3);
  }

  /* ── Link ──────────────────────────── */
  .sidebar-link {
    display: block;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    text-decoration: none;
    border-radius: var(--radius-md);
    border-left: 2px solid transparent;
    transition: color var(--transition-fast), background var(--transition-fast),
      text-shadow var(--transition-fast), border-color var(--transition-fast);
    line-height: var(--leading-normal);
  }

  .sidebar-link:hover {
    color: var(--color-text);
    background: var(--glass-bg-hover);
    text-shadow: 0 0 10px rgba(124, 58, 237, 0.2);
    text-decoration: none;
  }

  .sidebar-link.is-current {
    color: var(--color-text);
    background: rgba(124, 58, 237, 0.1);
    border-left-color: transparent;
    border-image: var(--gradient-primary) 1;
    border-image-slice: 1;
    font-weight: 600;
    text-shadow: 0 0 12px rgba(124, 58, 237, 0.2);
  }

  /* ── Responsive ───────────────────── */
  @media (max-width: 768px) {
    .docs-sidebar {
      position: static;
      max-height: none;
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      padding: var(--space-3);
      background: var(--glass-bg);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
    }
  }
</style>
