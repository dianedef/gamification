---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

const pageTitle = 'La science de la gamification — Gamification';
const metaDescription = '22 articles, 14 000 lignes de recherche. Neurosciences, psychologie, frameworks, éthique — tout ce qu\'il faut pour concevoir une gamification qui sert l\'humain.';
const canonicalURL = new URL('/', Astro.site);
const ogImageURL = new URL('/og-default.png', Astro.site);

const websiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Gamification',
  description: metaDescription,
  url: Astro.site?.href,
  inLanguage: 'fr',
});
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="Gamification" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImageURL.href} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={websiteJsonLd} />
  </head>

  <body>
    <a class="skip-link" href="#main-content">Aller au contenu</a>
    <Header currentPath="/" />

    <div class="site-page">

      <!-- ══════════════════════════════════════════════
           HERO
           ══════════════════════════════════════════════ -->
      <section class="hero" id="main-content">
        <div class="hero__dot-grid" aria-hidden="true"></div>
        <div class="hero__glow hero__glow--1" aria-hidden="true"></div>
        <div class="hero__glow hero__glow--2" aria-hidden="true"></div>

        <div class="hero__inner">
          <span class="hero__badge">
            <span class="hero__badge-dot" aria-hidden="true"></span>
            Base de connaissances open source
          </span>

          <h1 class="hero__title">
            La science de la<br />
            <span class="hero__title-gradient">gamification</span>
          </h1>

          <p class="hero__subtitle">
            22 articles, 14 000+ lignes de recherche.<br class="hero__subtitle-br" />
            Neurosciences, psychologie, frameworks, éthique — tout ce qu'il faut
            pour concevoir une gamification qui <em>sert l'humain</em>.
          </p>

          <div class="hero__actions">
            <a class="btn btn--primary" href="/comprendre/neurosciences">
              Commencer par les bases
              <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="btn btn--outline" href="/outils/interactifs">
              Explorer les outils
            </a>
          </div>
        </div>

        <!-- Stats counters -->
        <div class="hero__stats">
          <div class="stat-glass">
            <span class="stat-glass__icon" aria-hidden="true">&#128218;</span>
            <span class="stat-glass__number">22</span>
            <span class="stat-glass__label">articles</span>
          </div>
          <div class="stat-glass">
            <span class="stat-glass__icon" aria-hidden="true">&#128736;&#65039;</span>
            <span class="stat-glass__number">7</span>
            <span class="stat-glass__label">outils</span>
          </div>
          <div class="stat-glass">
            <span class="stat-glass__icon" aria-hidden="true">&#128209;</span>
            <span class="stat-glass__number">14 000+</span>
            <span class="stat-glass__label">lignes</span>
          </div>
          <div class="stat-glass">
            <span class="stat-glass__icon" aria-hidden="true">&#128214;</span>
            <span class="stat-glass__number">40+</span>
            <span class="stat-glass__label">références</span>
          </div>
        </div>
      </section>

      <!-- ══════════════════════════════════════════════
           SECTIONS (6 cards)
           ══════════════════════════════════════════════ -->
      <section class="sections">
        <div class="sections__inner">
          <h2 class="section-heading">Explorer par section</h2>
          <p class="section-subheading">Six piliers pour maîtriser la gamification, de la théorie à la pratique.</p>

          <div class="sections__grid">
            <a class="glass-card glass-card--purple" href="/comprendre/neurosciences">
              <span class="glass-card__icon" aria-hidden="true">&#129504;</span>
              <div class="glass-card__content">
                <h3>Comprendre</h3>
                <p>Neurosciences, psychologie, comportement</p>
              </div>
              <span class="glass-card__badge">5 articles</span>
            </a>

            <a class="glass-card glass-card--blue" href="/concevoir/frameworks">
              <span class="glass-card__icon" aria-hidden="true">&#127959;</span>
              <div class="glass-card__content">
                <h3>Concevoir</h3>
                <p>Frameworks, mécaniques, études de cas</p>
              </div>
              <span class="glass-card__badge">3 articles</span>
            </a>

            <a class="glass-card glass-card--cyan" href="/creer/copywriting">
              <span class="glass-card__icon" aria-hidden="true">&#9997;&#65039;</span>
              <div class="glass-card__content">
                <h3>Créer</h3>
                <p>Copywriting, UX, implémentation, IA</p>
              </div>
              <span class="glass-card__badge">4 articles</span>
            </a>

            <a class="glass-card glass-card--emerald" href="/valider/metriques">
              <span class="glass-card__icon" aria-hidden="true">&#9878;&#65039;</span>
              <div class="glass-card__content">
                <h3>Valider</h3>
                <p>Métriques, éthique, dark patterns</p>
              </div>
              <span class="glass-card__badge">2 articles</span>
            </a>

            <a class="glass-card glass-card--gold" href="/humain/utilisateur-personne">
              <span class="glass-card__icon" aria-hidden="true">&#128100;</span>
              <div class="glass-card__content">
                <h3>L'humain</h3>
                <p>La personne derrière l'utilisateur</p>
              </div>
              <span class="glass-card__badge">5 articles</span>
            </a>

            <a class="glass-card glass-card--rose" href="/outils/prompts-ia">
              <span class="glass-card__icon" aria-hidden="true">&#129520;</span>
              <div class="glass-card__content">
                <h3>Outils</h3>
                <p>Prompts, glossaire, 7 outils interactifs</p>
              </div>
              <span class="glass-card__badge">4 ressources</span>
            </a>
          </div>
        </div>
      </section>

      <!-- ══════════════════════════════════════════════
           INTERACTIVE TOOLS SHOWCASE
           ══════════════════════════════════════════════ -->
      <section class="tools">
        <div class="tools__inner">
          <div class="tools__header">
            <span class="tools__label">&#128302; Interactif</span>
            <h2 class="section-heading">7 outils interactifs</h2>
            <p class="section-subheading">Audite, diagnostique et conçois ta gamification directement dans le navigateur.</p>
          </div>

          <div class="tools__grid">
            <div class="tool-card">
              <div class="tool-card__number" aria-hidden="true">01</div>
              <h3>Audit de gamification</h3>
              <p>Évalue la maturité de ton système gamifié avec un score détaillé et des recommandations concrètes.</p>
              <span class="tool-card__tag">Diagnostic</span>
            </div>

            <div class="tool-card">
              <div class="tool-card__number" aria-hidden="true">02</div>
              <h3>Calculateur d'engagement</h3>
              <p>Simule l'impact de chaque mécanique sur tes métriques clés : rétention, activation, revenus.</p>
              <span class="tool-card__tag">Simulation</span>
            </div>

            <div class="tool-card">
              <div class="tool-card__number" aria-hidden="true">03</div>
              <h3>Générateur de boucles</h3>
              <p>Construis des boucles d'engagement trigger-action-reward visuellement, étape par étape.</p>
              <span class="tool-card__tag">Conception</span>
            </div>
          </div>

          <div class="tools__cta">
            <a class="btn btn--outline btn--lg" href="/outils/interactifs">
              Explorer tous les outils
              <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </section>

      <!-- ══════════════════════════════════════════════
           LEARNING PATHS
           ══════════════════════════════════════════════ -->
      <section class="paths">
        <div class="paths__inner">
          <h2 class="section-heading">Par où commencer ?</h2>
          <p class="section-subheading">Trois parcours selon ton niveau et tes objectifs.</p>

          <div class="paths__grid">
            <!-- Path 1 -->
            <div class="path-card path-card--beginner">
              <div class="path-card__header">
                <span class="path-card__emoji" aria-hidden="true">&#127793;</span>
                <span class="path-card__level">Débutant</span>
              </div>
              <h3>Je pars de zéro</h3>
              <p>Parcours complet pour découvrir la gamification de A à Z.</p>
              <ol class="path-card__steps">
                <li><a href="/comprendre/neurosciences">Neurosciences de la gamification</a></li>
                <li><a href="/comprendre/psychologie">Psychologie de la motivation</a></li>
                <li><a href="/comprendre/design-comportemental">Design comportemental</a></li>
                <li><a href="/concevoir/frameworks">Frameworks de gamification</a></li>
                <li><a href="/concevoir/mecaniques">Mécaniques de jeu</a></li>
                <li><a href="/humain/utilisateur-personne">L'utilisateur en tant que personne</a></li>
                <li><a href="/valider/ethique">Éthique et dark patterns</a></li>
              </ol>
              <div class="path-card__footer">
                <span class="path-card__duration">~2h de lecture</span>
              </div>
            </div>

            <!-- Path 2 -->
            <div class="path-card path-card--intermediate">
              <div class="path-card__header">
                <span class="path-card__emoji" aria-hidden="true">&#128269;</span>
                <span class="path-card__level">Amélioration</span>
              </div>
              <h3>Je veux améliorer</h3>
              <p>Audit et optimisation d'un système de gamification existant.</p>
              <ol class="path-card__steps">
                <li><a href="/valider/metriques">Métriques et analytics</a></li>
                <li><a href="/outils/interactifs">Audit interactif</a></li>
                <li><a href="/valider/ethique">Éthique et dark patterns</a></li>
                <li><a href="/humain/alignement-purpose">Alignement de purpose</a></li>
                <li><a href="/humain/responsabilite-service">Responsabilité de service</a></li>
              </ol>
              <div class="path-card__footer">
                <span class="path-card__duration">~1h30 de lecture</span>
              </div>
            </div>

            <!-- Path 3 -->
            <div class="path-card path-card--advanced">
              <div class="path-card__header">
                <span class="path-card__emoji" aria-hidden="true">&#9889;</span>
                <span class="path-card__level">Quick wins</span>
              </div>
              <h3>Je veux du concret</h3>
              <p>Les ressources les plus actionnables, directement.</p>
              <ul class="path-card__steps">
                <li><a href="/concevoir/mecaniques">32 mécaniques de jeu</a></li>
                <li><a href="/creer/copywriting">Copywriting et persuasion</a></li>
                <li><a href="/outils/prompts-ia">Prompts IA prêts à l'emploi</a></li>
                <li><a href="/outils/interactifs">7 outils interactifs</a></li>
                <li><a href="/concevoir/etudes-de-cas">Études de cas</a></li>
              </ul>
              <div class="path-card__footer">
                <span class="path-card__duration">~30 min</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ══════════════════════════════════════════════
           FOOTER CTA
           ══════════════════════════════════════════════ -->
      <section class="cta-footer">
        <div class="cta-footer__inner">
          <div class="cta-footer__glow" aria-hidden="true"></div>
          <span class="cta-footer__icon" aria-hidden="true">&#9889;</span>
          <h2>Cette base de connaissances est <span class="text-gradient">open source</span></h2>
          <p>Contribue, propose des améliorations ou utilise le contenu librement.</p>
          <a class="btn btn--outline btn--lg" href="https://github.com" target="_blank" rel="noopener noreferrer">
            Voir sur GitHub
            <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
          <div class="cta-footer__credit">
            Construit avec soin et Astro
          </div>
        </div>
      </section>

    </div>

    <Footer />
  </body>
</html>

<style>
  /* ══════════════════════════════════════════════════════════════════════════
     KEYFRAMES
     ══════════════════════════════════════════════════════════════════════════ */

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slide-up-delayed {
    0%, 20% {
      opacity: 0;
      transform: translateY(30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes glow-drift-1 {
    0%, 100% {
      transform: translate(-30%, -30%) scale(1);
      opacity: 0.4;
    }
    50% {
      transform: translate(-20%, -40%) scale(1.15);
      opacity: 0.6;
    }
  }

  @keyframes glow-drift-2 {
    0%, 100% {
      transform: translate(20%, 20%) scale(1);
      opacity: 0.3;
    }
    50% {
      transform: translate(30%, 10%) scale(1.2);
      opacity: 0.5;
    }
  }

  @keyframes dot-shift {
    0%, 100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.45;
    }
  }

  @keyframes pulse-badge {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.3);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(99, 102, 241, 0);
    }
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(50px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes shimmer {
    0% {
      background-position: -200% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  /* ══════════════════════════════════════════════════════════════════════════
     GLOBAL OVERRIDES
     ══════════════════════════════════════════════════════════════════════════ */

  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: 9999;
    padding: var(--space-2) var(--space-4);
    background: var(--color-primary-600);
    color: #fff;
    border-radius: var(--radius-md);
    font-weight: 600;
    text-decoration: none;
  }

  .skip-link:focus {
    top: var(--space-2);
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    background: #050510;
    color: #e2e8f0;
  }

  .site-page {
    flex: 1;
    width: 100%;
    padding-top: var(--header-height);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SHARED TEXT STYLES
     ══════════════════════════════════════════════════════════════════════════ */

  .text-gradient {
    background: linear-gradient(135deg, #a855f7, #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-heading {
    text-align: center;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #f1f5f9;
    margin-bottom: var(--space-3);
  }

  .section-subheading {
    text-align: center;
    font-size: var(--text-lg);
    color: #94a3b8;
    max-width: 48ch;
    margin: 0 auto var(--space-12);
    line-height: var(--leading-relaxed);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     BUTTONS
     ══════════════════════════════════════════════════════════════════════════ */

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.85rem 2rem;
    border-radius: var(--radius-xl);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
    border: 2px solid transparent;
    position: relative;
    letter-spacing: 0.01em;
  }

  .btn--primary {
    background: linear-gradient(135deg, #7c3aed, #6366f1, #06b6d4);
    color: #fff;
    box-shadow:
      0 0 20px rgba(99, 102, 241, 0.4),
      0 4px 15px rgba(0, 0, 0, 0.3);
  }

  .btn--primary:hover {
    box-shadow:
      0 0 35px rgba(99, 102, 241, 0.6),
      0 6px 20px rgba(0, 0, 0, 0.4);
    transform: translateY(-2px);
    color: #fff;
    text-decoration: none;
  }

  .btn--outline {
    background: rgba(255, 255, 255, 0.03);
    color: #c4b5fd;
    border-color: rgba(139, 92, 246, 0.3);
    backdrop-filter: blur(8px);
  }

  .btn--outline:hover {
    background: rgba(139, 92, 246, 0.1);
    border-color: rgba(139, 92, 246, 0.6);
    color: #ddd6fe;
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn--lg {
    padding: 1rem 2.5rem;
    font-size: var(--text-base);
  }

  .btn__arrow {
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .btn:hover .btn__arrow {
    transform: translateX(4px);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     HERO
     ══════════════════════════════════════════════════════════════════════════ */

  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 12vh, 8rem) var(--space-6) clamp(4rem, 8vh, 6rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 85vh;
    justify-content: center;
    background: radial-gradient(ellipse 80% 60% at 50% 20%, rgba(99, 102, 241, 0.08) 0%, transparent 70%),
                radial-gradient(ellipse 60% 40% at 80% 80%, rgba(6, 182, 212, 0.05) 0%, transparent 60%),
                #050510;
  }

  /* Dot grid background */
  .hero__dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(148, 163, 184, 0.15) 1px, transparent 1px);
    background-size: 32px 32px;
    animation: dot-shift 8s ease-in-out infinite;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 30%, transparent 70%);
  }

  /* Floating glow orbs */
  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  .hero__glow--1 {
    width: 500px;
    height: 500px;
    background: rgba(124, 58, 237, 0.15);
    top: 10%;
    left: 20%;
    animation: glow-drift-1 12s ease-in-out infinite;
  }

  .hero__glow--2 {
    width: 400px;
    height: 400px;
    background: rgba(6, 182, 212, 0.12);
    bottom: 10%;
    right: 15%;
    animation: glow-drift-2 15s ease-in-out infinite;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 780px;
    animation: slide-up 0.8s ease-out both;
  }

  /* Badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4rem 1.2rem;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #c4b5fd;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.2);
    margin-bottom: var(--space-8);
    animation: pulse-badge 3s ease-in-out infinite;
  }

  .hero__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #a78bfa;
    animation: float 2s ease-in-out infinite;
  }

  /* Title */
  .hero__title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: #f8fafc;
    margin-bottom: var(--space-6);
  }

  .hero__title-gradient {
    background: linear-gradient(135deg, #a855f7 0%, #8b5cf6 25%, #6366f1 50%, #06b6d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% auto;
    animation: shimmer 6s linear infinite;
  }

  /* Subtitle */
  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #94a3b8;
    line-height: 1.7;
    max-width: 56ch;
    margin: 0 auto var(--space-10);
    animation: slide-up-delayed 1s ease-out both;
  }

  .hero__subtitle em {
    color: #c4b5fd;
    font-style: normal;
    font-weight: 600;
  }

  .hero__subtitle-br {
    display: none;
  }

  /* Actions */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    animation: slide-up-delayed 1.2s ease-out both;
  }

  /* Stats bar */
  .hero__stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    max-width: 700px;
    width: 100%;
    margin-top: clamp(3rem, 6vh, 5rem);
    animation: slide-up-delayed 1.4s ease-out both;
  }

  .stat-glass {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 1.25rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-xl);
