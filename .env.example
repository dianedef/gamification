# .env.example
# Gamification library environment template
# No required environment variables are needed to build or run this package.
# Uncomment and override any values that your local environment or CI expects.

# Optional diagnostics
# GAMIFICATION_DEBUG=false
# VITE_GAMIFICATION_TRACKING=0

# Optional CI/release helpers
# NPM_TOKEN=your-npm-token
# NODE_AUTH_TOKEN=your-node-auth-token
